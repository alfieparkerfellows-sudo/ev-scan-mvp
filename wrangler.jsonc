{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ev-scan-mvp",
  "main": "./worker.js",
  "compatibility_date": "2026-08-24",
  "vars": {
    "DVSA_TOKEN_URL": "https://login.microsoftonline.com/a455b827-244f-4c97-b5b4-ce5d13b4d00c/oauth2/v2.0/token",
    "DVSA_SCOPE": "https://tapi.dvsa.gov.uk/.default",
    "DVSA_API_BASE": "https://history.mot.api.gov.uk"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/ev-guides",
      "/ev-guides/*",
      "/cars",
      "/cars/*",
      "/compare/*",
      "/best/*",
      "/robots.txt",
      "/sitemap.xml",
      "/evscan-sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true
  }
}
